PORT=3000
CORS_ORIGIN=http://localhost:8080
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/db_agent_helpdesk
MONGODB_DB=db_agent_helpdesk
KNOWLEDGE_COLLECTION=tm_knowledge_helpdesk
CHAT_COLLECTION=tt_chat_helpdesk
TRAINING_SESSION_COLLECTION=tt_chat_training
TRAINING_MESSAGE_COLLECTION=tt_chat_training_message
AGENT_TRACE_COLLECTION=tt_agent_trace
TICKET_COLLECTION=tt_ticket_helpdesk
HELPDESK_USER_COLLECTION=tm_helpdesk_user

# DeepSeek - main agent (thinking/default behavior tetap tidak dipaksa)
DEEPSEEK_API_KEY=ISI_API_KEY_DEEPSEEK_ANDA
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_TIMEOUT_MS=60000
VISUAL_ATTACHMENT_ANALYSIS_ENABLED=true
VISUAL_ATTACHMENT_MAX_FILES=3
HELPDESK_AUTH_SECRET=ganti-dengan-secret-panjang-random
HELPDESK_DEFAULT_PASSWORD=admin12345

# Summary model - hanya aktif pada chat panjang, thinking dinonaktifkan di code agar cepat
DEEPSEEK_SUMMARY_MODEL=deepseek-v4-flash
DEEPSEEK_SUMMARY_TIMEOUT_MS=30000

# Agent limits
# Budget dibuat selaras: 2 search, maksimal 4 model call, dan ruang graph yang cukup.
AGENT_RECURSION_LIMIT=20
MODEL_CALL_RUN_LIMIT=4
SEARCH_TOOL_CALL_LIMIT=2
DEBUG_AGENT=true
DEBUG_RETRIEVAL=true

# LangGraph Checkpointer (short-term memory / state per session)
CHECKPOINTER_ENABLED=true
CHECKPOINT_COLLECTION=tt_agent_checkpoint
CHECKPOINT_WRITES_COLLECTION=tt_agent_checkpoint_write
# 0 = tanpa TTL. Isi detik jika ingin auto-expire checkpoint lama.
CHECKPOINT_TTL_SECONDS=0

# Adaptive summarization - tidak ada extra LLM call sebelum threshold tercapai
SUMMARIZATION_ENABLED=true
SUMMARIZATION_TRIGGER_MESSAGES=30
SUMMARIZATION_TRIGGER_TOKENS=8000
SUMMARIZATION_KEEP_MESSAGES=10
SUMMARIZATION_MAX_TOKENS=6000

# MongoDBStore long-term customer memory
# Aktif jika request mengirim customer_id stabil.
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_COLLECTION=tm_nava_customer_memory
LONG_TERM_MEMORY_CASE_LIMIT=8
LONG_TERM_MEMORY_ANSWER_MAX_CHARS=500

# Fallback untuk migrasi chat lama sebelum v2.4
CROSS_SESSION_CONTEXT_ENABLED=true
CROSS_SESSION_HISTORY_LIMIT=6
CROSS_SESSION_MESSAGE_MAX_CHARS=500
CROSS_SESSION_ANSWER_MAX_CHARS=500

# Hybrid retrieval
KNOWLEDGE_TOP_K=5
MIN_RETRIEVAL_COVERAGE=0.20
VECTOR_SEARCH_ENABLED=true
VECTOR_INDEX_NAME=knowledge_vector_index
VECTOR_FIELD=embedding
QDRANT_URL=http://localhost:6333
# Isi hanya jika Qdrant dikonfigurasi dengan API key.
# QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_vector_index
QDRANT_TIMEOUT_MS=10000
QDRANT_RECONCILE_ON_START=true
VECTOR_CANDIDATE_LIMIT=20
MIN_VECTOR_SCORE=0.89
HYBRID_KEYWORD_WEIGHT=1.0
HYBRID_VECTOR_WEIGHT=1.25
HYBRID_PROBLEM_WEIGHT=3.0

# Local multilingual embedding
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_PROFILE=problem-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_DTYPE=q8
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=1800
EMBEDDING_WARMUP_ON_START=false

# Optional LangSmith tracing (tidak wajib)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=nava-helpdesk
